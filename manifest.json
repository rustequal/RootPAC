{
  "manifest_version": 3,
  "name": "RootPAC",
  "version": "1.0.15",
  "description": "Routes a site and every host it loads through your proxy by learning them into a generated PAC.",
  "minimum_chrome_version": "145",
  "permissions": [
    "proxy",
    "privacy",
    "storage",
    "declarativeNetRequest",
    "webRequest",
    "webNavigation",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/main.js",
    "type": "module"
  },
  "content_security_policy": {
    "sandbox": "sandbox allow-scripts; default-src 'none'; script-src 'self' 'unsafe-eval'"
  },
  "sandbox": {
    "pages": [
      "src/sandbox/sandbox.html"
    ]
  },
  "action": {
    "default_popup": "src/ui/popup/popup.html",
    "default_icon": {
      "16": "icons/brand-16.png",
      "32": "icons/brand-32.png"
    }
  },
  "options_page": "src/ui/options/options.html",
  "icons": {
    "16": "icons/brand-16.png",
    "32": "icons/brand-32.png",
    "48": "icons/brand-48.png",
    "128": "icons/brand-128.png"
  }
}
